SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Provided by Manus WebDev runtime when AI is enabled:
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Make.com webhook (POST /api/news) — ตั้งเป็นสตริงสุ่มยาว ๆ แล้วใส่ค่าเดียวกันใน header X-Webhook-Secret ของ Make
MAKE_WEBHOOK_SECRET=
# true = ข่าวจาก Make แสดงทันที / false = บันทึกเป็นฉบับร่างให้แอดมินตรวจก่อน
NEWS_AUTO_PUBLISH=true
